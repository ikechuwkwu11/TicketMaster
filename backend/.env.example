DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail SMTP — sender for transfer emails (use a Google App Password, not your login password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=0
EMAIL_USE_SSL=1
EMAIL_HOST_USER=Xptraveler78@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Xptraveler78@gmail.com
EMAIL_FROM_NAME=Ticketmaster
FRONTEND_PUBLIC_URL=http://localhost:5173

# Web Push (generate with: python -c "from py_vapid import Vapid01; ..." or web-push CLI)
# Never put VAPID_PRIVATE_KEY in frontend code.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@ticketmaster.local
