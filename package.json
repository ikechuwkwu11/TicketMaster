{
  "name": "ticketmaster",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:pwa": "cross-env VITE_BASE=/ vite build && vite preview --host --port 5173",
    "build:pages": "cross-env VITE_BASE=/TicketMaster/ vite build",
    "deploy:pages": "npm run build:pages && npx gh-pages -d dist -b gh-pages",
    "backend:install": "python -m pip install -r backend/requirements.txt",
    "backend:migrate": "python backend/manage.py migrate",
    "backend:seed": "python backend/manage.py seed_catalog --reset",
    "backend:run": "python backend/manage.py runserver 8000"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
